Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# 1. Force HTTPS non-www domain
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.quickartphotography\.in$ [NC]
RewriteRule ^(.*)$ https://quickartphotography.in/$1 [L,R=301]

# 2. Redirect /index.html to /
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html [NC]
RewriteRule ^index\.html$ https://quickartphotography.in/ [R=301,L]

# 3. Redirect any /directory/index.html to /directory/
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /(.*?)/index\.html [NC]
RewriteRule ^(.*?)/index\.html$ https://quickartphotography.in/$1/ [R=301,L]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header set X-Robots-Tag "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
<FilesMatch "(admin\.html|email-template-preview\.html)">
  Header set X-Robots-Tag "noindex, nofollow"
</FilesMatch>
<FilesMatch "sw\.js$">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires 0
</FilesMatch>
<FilesMatch "manifest\.json$">
  Header set Content-Type "application/manifest+json; charset=utf-8"
</FilesMatch>
</IfModule>

# ─── GZIP Compression (deduped, single block) ───────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml font/woff font/woff2
</IfModule>

# ─── Legacy 301 Redirects (SEO preservation for indexed pages) ──────────────
RedirectMatch 301 ^/courses/graphic-design/?$ /courses/album-design/
RedirectMatch 301 ^/courses/graphic-design/index\.html$ /courses/album-design/
RedirectMatch 301 ^/adobe-premiere-pro-course/?$ /online/premiere-pro-course/
RedirectMatch 301 ^/adobe-premiere-pro-course/index\.html$ /online/premiere-pro-course/
RedirectMatch 301 ^/best-davinci-resolve-online-course-in-hindi/?$ /online/davinci-resolve-course/
RedirectMatch 301 ^/best-davinci-resolve-online-course-in-hindi/index\.html$ /online/davinci-resolve-course/
RedirectMatch 301 ^/join-video-editing-album-design-course/?$ /online/album-design-course/
RedirectMatch 301 ^/join-video-editing-album-design-course/index\.html$ /online/album-design-course/
# Server-side 301s for legacy stub pages (meta-refresh pages kept only as a fallback)
RedirectMatch 301 ^/home(/|/index\.html)?$ /
RedirectMatch 301 ^/contact-quick-art-photography-academy(/|/index\.html)?$ /contact-us/
RedirectMatch 301 ^/courses/ai-marketing(/|/index\.html)?$ /courses/ai-digital-marketing/
RedirectMatch 301 ^/edius-online-course(/|/index\.html)?$ /online/edius-course/
RedirectMatch 301 ^/edius-online-course-in-india(/|/index\.html)?$ /online/edius-course/
RedirectMatch 301 ^/premiere-pro-online-course-in-india(/|/index\.html)?$ /online/premiere-pro-course/
RedirectMatch 301 ^/top-5-editing-course-academies-in-bihar(/|/index\.html)?$ /blog/top-5-editing-course-academies-in-patna/
RedirectMatch 301 ^/top-5-editing-course-academies-in-patna(/|/index\.html)?$ /blog/top-5-editing-course-academies-in-patna/
RedirectMatch 301 ^/video-editing-course(/|/index\.html)?$ /courses/video-editing/

# ─── Browser Caching (Aggressive — 1 year for immutable assets) ─────────────
<IfModule mod_expires.c>
  ExpiresActive On
  # Images & media — 1 year (immutable)
  ExpiresByType image/webp       "access plus 1 year"
  ExpiresByType image/jpeg       "access plus 1 year"
  ExpiresByType image/png        "access plus 1 year"
  ExpiresByType image/gif        "access plus 1 year"
  ExpiresByType image/svg+xml    "access plus 1 year"
  ExpiresByType image/avif       "access plus 1 year"
  # Fonts — 1 year (immutable)
  ExpiresByType font/woff2       "access plus 1 year"
  ExpiresByType font/woff        "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  # CSS & JS — 30 days (versioned via ?v= query strings)
  ExpiresByType text/css         "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType text/javascript  "access plus 30 days"
  # HTML — 1 day (allows SEO updates to propagate quickly)
  ExpiresByType text/html        "access plus 1 day"
  # Data
  ExpiresByType application/json "access plus 1 hour"
</IfModule>

# ─── Cache-Control Headers ───────────────────────────────────────────────────
<IfModule mod_headers.c>
  # Immutable static assets — 1 year cache, no re-validation needed
  <FilesMatch "\.(webp|jpg|jpeg|png|gif|svg|avif|ico|woff2|woff)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>

  # Versioned CSS & JS — 30 days, stale-while-revalidate for instant feel
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "max-age=2592000, public, stale-while-revalidate=86400"
  </FilesMatch>

  # HTML pages — short cache, must-revalidate for SEO freshness
  <FilesMatch "\.html$">
    Header set Cache-Control "max-age=86400, public, must-revalidate"
  </FilesMatch>
</IfModule>
